# Settings of the OpenWrt connection map. Copy to .env and edit. Comments only on their own lines.

# Router address as the service (or the proxy) sees it; https:// works too (the certificate is not verified)
router_url=http://192.168.1.1
# rpcd user with the read-only ACL, see README.md, "Настройка роутера"
username=map
password=

# host:port of an HTTP proxy if the router is reachable only through it; empty for a direct connection
proxy=

# logical OpenWrt interface that faces the internet
wan_interface=wan

# seconds between polls of metrics and connections (minimum 5)
poll_interval=15
# seconds between re-reading interfaces, firewall, listening ports and the names file
config_interval=300

# where the map is served; 0.0.0.0 opens it to the local network (the map has no authorization)
http_host=127.0.0.1
http_port=8787

# External address. Empty: the WAN address; if it is private (the router is behind another router or
# provider NAT), ask ifconfig.me through the same proxy. An address: use it. off: never ask.
public_ip=
# lat,lng of the router when DB-IP does not know the place of the external address
location=

# address -> name for devices and remote hosts, see names.conf.example; DHCP names come from the router
names_file=names.conf
