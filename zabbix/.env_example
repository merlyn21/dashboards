# Zabbix Galaxy settings: an example to copy.
#
#   cp .env_example .env          # then edit .env
#   chmod 600 .env                # the file holds a credential
#   python3 server.py             # reads .env
#   python3 server.py env_prod    # reads .env_prod instead (any name works)
#
# Format: KEY=value, one per line; quotes are optional, "#" starts a comment line.
# Real environment variables override values from this file, so the same keys work
# with `docker run -e`, docker compose `environment:` / `env_file:` and systemd.
# Never commit the real .env: only this example belongs in git.

# --- Zabbix API ---------------------------------------------------------------

# Zabbix frontend URL; /api_jsonrpc.php is appended automatically.
# Inside a docker compose file next to Zabbix, use the service name and the
# container port instead: http://zabbix-web:8080
ZABBIX_URL=https://zabbix.example.com

# Authentication: an API token (recommended) OR a user name and password.
# When ZABBIX_TOKEN is set, ZABBIX_USER / ZABBIX_PASSWORD are ignored.
#
# Recommended setup in Zabbix (Users menu):
#   1. User role: type "User", API access enabled, API methods allow list:
#      host.get, item.get, trigger.get, history.get, trend.get
#   2. User group: Read permission on the host groups to show, frontend access disabled.
#   3. User in that group with that role.
#   4. Users -> API tokens -> Create API token for that user; copy it (shown once).
# The token needs Zabbix 5.4+; the Bearer header this server sends needs Zabbix 6.4+.
ZABBIX_TOKEN=paste-your-64-character-api-token-here

# Alternative to the token (a session is opened at start and closed on exit).
# ZABBIX_USER=galaxy-api
# ZABBIX_PASSWORD=change-me

# Optional HTTP(S) proxy for the Zabbix API calls, e.g. when Zabbix is only reachable
# through a jump host. Credentials in the URL are masked in the log.
# Leave empty to connect directly (system HTTP_PROXY / HTTPS_PROXY still apply).
ZABBIX_PROXY=
# ZABBIX_PROXY=http://user:password@192.168.1.10:8888

# --- Dashboard ----------------------------------------------------------------

# Listen address and port. 127.0.0.1 keeps the dashboard local: it has no login of
# its own, so anyone who can open the port sees the monitoring data. Use 0.0.0.0 only
# behind a reverse proxy with authentication or inside a trusted network.
# The Docker image always sets GALAXY_HOST=0.0.0.0 and GALAXY_PORT=8080 inside the
# container; choose the published port with `-p` / `ports:` instead.
GALAXY_HOST=127.0.0.1
GALAXY_PORT=8080

# Interface language: ru or en.
GALAXY_LANG=ru

# Important services, comma separated, case-insensitive substrings of a service name.
# Matching OS services (Windows services, systemd units) become large stations, the rest
# are folded into one small "services" satellite. Template services (mysql, postgresql,
# 1c, docker, zabbix) that match are highlighted too.
# Empty: the default set (PostgreSQL and 1C services on Windows).
GALAXY_SERVICES=postgres,mysql,nginx

# --- Environment-only options (not read from this file) --------------------------
# Set these as real environment variables if needed:
#   GALAXY_WIN_SERVICES   regex of Windows services worth showing
#                         (default: postgres|pgsql|1C agents)
#   GALAXY_WEB_USERS_KEY  item key with the number of Zabbix web users online
#                         (default: zabbix.web.users.online)
#   GALAXY_DEBUG=1        log every HTTP request to the dashboard
