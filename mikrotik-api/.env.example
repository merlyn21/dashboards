# Copy to .env and fill in. Comments only on their own lines: text after a value is part of the value.
# Every key can also be set as an environment variable in upper case (SERVER_API, POLL_INTERVAL, ...).

# Router address as seen from this machine (or from the proxy), and the API port (8728, plain API).
server_api=192.168.88.1
port_api=8728

# API user with read + api policy only. See README.md, "Пользователь API на MikroTik".
username_api=map-api
password_api="change-me"

# host:port of an HTTP proxy with CONNECT, if the router is reachable only through it. Empty: direct connection.
proxy=

# Seconds between polls of metrics and connections (minimum 5).
poll_interval=30

# always: poll the router all the time (rates and hourly counters are ready when the map opens).
# clients: poll only while the map is open in a browser; idle_timeout seconds after the last one
# closes, the API session is closed and polling stops until the map is opened again.
poll_mode=always
idle_timeout=300

# Seconds between re-reading services and firewall rules for the ports plate.
config_interval=300

# WAN interface. Empty: taken from the DHCP client or the WAN interface list.
wan_interface=

# Where the map is served. 127.0.0.1: this machine only; 0.0.0.0: the whole LAN. The Docker image sets 0.0.0.0.
http_host=127.0.0.1
http_port=8787
