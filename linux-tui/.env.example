# Settings of the terminal connection view. Copy to .env and edit. Comments only on their own lines.

# router: WAN + LAN behind NAT (two or more interfaces); host: a single server, usually in a cloud
mode=host

# WAN interface; empty: the interface of the default route
wan_interface=

# router mode: LAN interfaces, comma separated; empty: every other interface except lo, docker, veth.
# tun*/tap*/wg* interfaces are added automatically in both modes (VPN clients count as devices).
lan_interfaces=


# seconds between polls of metrics and connections (minimum 5)
poll_interval=10
# seconds between re-reading addresses, firewall, listeners and the names file
config_interval=300

# External address. Empty: the WAN address; if it is private (cloud 1:1 NAT, provider NAT),
# ask ifconfig.me (api.ipify.org as a fallback) every config_interval. An address: use it. off: never ask.
public_ip=
# lat,lng of this machine when DB-IP does not know the place of the external address
location=

# address -> name for devices and remote hosts, see names.conf.example
names_file=names.conf

# on: set net.netfilter.nf_conntrack_acct=1 at start. Without it connections have no byte counters and no rates.
conntrack_acct=on
# on: follow `conntrack -E` for starts and ends between polls
conntrack_events=on

# OpenVPN status files, comma separated; empty: /run/openvpn-server/*.log, /run/openvpn/*.status and so on
openvpn_status=

# auto: IPv6 places and ip6tables only if the WAN has a global IPv6 address; on; off
ipv6=auto
